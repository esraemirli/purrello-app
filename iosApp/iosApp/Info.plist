<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Launch screen: the system draws this before the app runs (KAN-7). Assets.xcassets/SplashBackground, SplashMark. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>SplashBackground</string>
		<key>UIImageName</key>
		<string>SplashMark</string>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Keep in sync with composeResources/values-* folders (localization.md §6). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>tr</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>tr</string>
	<!-- Values come from Configuration/Config.xcconfig, per build configuration. -->
	<key>PurrelloEnvironment</key>
	<string>$(PURRELLO_ENVIRONMENT)</string>
	<key>PurrelloBaseUrl</key>
	<string>$(PURRELLO_BASE_URL)</string>
	<key>PurrelloUseFakeApi</key>
	<string>$(PURRELLO_USE_FAKE_API)</string>
</dict>
</plist>
